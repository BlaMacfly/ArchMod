# Maintainer: BlaMacfly <expedycam@gmail.com>
#
# Paquet binaire : réempaquette le .deb officiel de la release GitHub.
# Installation en quelques secondes, sans Rust ni Node.

pkgname=archmod-bin
_pkgname=ArchMod
pkgver=0.5.0
pkgrel=1
pkgdesc="Gestionnaire graphique de trainers pour jeux Steam sous Proton (binaire officiel)"
arch=('x86_64')
url="https://github.com/BlaMacfly/ArchMod"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator-gtk3' 'librsvg' 'hicolor-icon-theme')
optdepends=(
  'protontricks: méthode d'"'"'injection de référence'
  'wine: repli lorsque protontricks est absent'
  'steam: bibliothèque de jeux à scanner'
)
provides=('archmod')
conflicts=('archmod')
source=("$pkgname-$pkgver.deb::$url/releases/download/v$pkgver/${_pkgname}_${pkgver}_amd64.deb")
# Somme du .deb de la release v0.5.0, produite par `updpkgsums`.
sha256sums=('f3c81750a864df763701b35c083886498a68499e2a66b0b15a6c08fbd3af175e')

package() {
  # Le .deb produit par Tauri contient déjà l'arborescence /usr attendue :
  # binaire, fichier .desktop et icônes hicolor.
  bsdtar -xf data.tar.* -C "$pkgdir"

  install -Dm644 "$pkgdir/usr/share/doc/$_pkgname/LICENSE" \
    "$pkgdir/usr/share/licenses/archmod/LICENSE" 2>/dev/null || true
}
