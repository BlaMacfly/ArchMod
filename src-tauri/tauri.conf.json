{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchMod",
  "version": "0.1.0",
  "identifier": "com.archmod.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArchMod",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0b10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.cache/ArchMod/banners/**",
          "$CACHE/ArchMod/banners/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Game",
    "shortDescription": "Gestionnaire de trainers pour jeux Steam sous Proton",
    "longDescription": "ArchMod associe vos jeux Steam à leurs trainers Windows et les injecte dans le bon préfixe Proton, sans quitter votre bureau Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
